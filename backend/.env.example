PORT=3000
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Generate these with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourdomain.com

# PostgreSQL connection string, e.g.:
# postgresql://oneness_app:yourpassword@localhost:5432/oneness_yoga?schema=public&connection_limit=10&pool_timeout=10&connect_timeout=10
DATABASE_URL=

# AI weekly schedule generator (Sequence Creator only) - get a key from openrouter.ai
# Feature is disabled gracefully if OPENROUTER_API_KEY is not set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
